# Telegram Scheduler Bot configuration
#
# Copy this file to ".env" and fill in real values:
#   cp .env.example .env

# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_USER_ID=123456789

# Database
# NOTE: Use a relative path for portability; in Docker this resolves to /app/data/scheduler.db
DATABASE_PATH=data/scheduler.db

# Logging
LOG_LEVEL=INFO

# Scheduler settings
SCHEDULER_CHECK_INTERVAL=60
DEFAULT_TIMEZONE=UTC

# Catch-up after downtime: how many posts to reschedule per schedule and the
# spacing (in seconds) between them.
# CATCHUP_MAX_RUNS_PER_SCHEDULE=5
# CATCHUP_SPACING_SECONDS=30

# Temporary directory for re-uploading stale media files (file_id refresh fallback).
# Defaults to data/temp; must be writable and ideally on a fast local filesystem.
# DOWNLOAD_TEMP_DIR=data/temp

# Admin notifications
# Per-event debounce window for the admin DM notifier (seconds; 0 disables debouncing).
# ADMIN_ERROR_DM_DEBOUNCE_SECONDS=60

# Heartbeat: ping the admin if any active schedule has not fired in this many hours.
# Default of 36h tolerates a once-a-day cron-style schedule slipping a single window.
# HEARTBEAT_MAX_HOURS=36

# Conversation persistence (PicklePersistence). Override only if you want to relocate
# the on-disk pickle (e.g., outside the data volume).
# BOT_PERSISTENCE_PATH=/app/data/conversation_state.pickle

# Logging
# LOG_FORMAT: "json" (default; one structured record per line) or "text" (human-readable).
# LOG_FORMAT=json
